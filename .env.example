# Copy to .env. Everything is optional: with nothing set, the agent runs offline (rule-based interpreter, no tracing).
# Postgres (docker compose -f docker/app/docker-compose.yml up -d) or sqlite:///carecall.db for a zero-setup run
DATABASE_URL=postgresql+psycopg://carecall:carecall@127.0.0.1:5433/carecall

# Phones used by `carecall seed` (put your own number as the "parent" to test real calls)
SEED_PARENT_PHONE=+91XXXXXXXXXX
SEED_CAREGIVER_PHONE=+91XXXXXXXXXX

# Reasoning model via OpenRouter (OpenAI-compatible). Use LLM_PROVIDER=fake to run fully offline.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-6-luna

# Self-hosted Langfuse (matches docker/langfuse/.env.example)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-carecall-local
LANGFUSE_SECRET_KEY=sk-lf-carecall-local

# Twilio + tunnel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app  # `carecall tunnel` fills this in
NGROK_AUTHTOKEN=
STREAM_SECRET=change-me
SMS_NOTIFICATIONS=false

# Gnani speech (adapters are stubs until the API docs are wired in)
GNANI_API_KEY=
