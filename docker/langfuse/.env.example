# Copy to docker/langfuse/.env. Local-only credentials; change before exposing anywhere.
# Headless init: creates org, project, user and API keys on first boot so no UI signup is needed.
LANGFUSE_INIT_ORG_ID=carecall-org
LANGFUSE_INIT_ORG_NAME=carecall
LANGFUSE_INIT_PROJECT_ID=carecall-dev
LANGFUSE_INIT_PROJECT_NAME=carecall-dev
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-carecall-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-carecall-local
LANGFUSE_INIT_USER_EMAIL=dev@carecall.local
LANGFUSE_INIT_USER_NAME=dev
LANGFUSE_INIT_USER_PASSWORD=change-me-locally
NEXTAUTH_URL=http://localhost:3000
